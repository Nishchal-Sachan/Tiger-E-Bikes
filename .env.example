# Copy to `.env.local` and set values. Never commit `.env.local`.
# Leave a line blank or omit the variable if you do not use that feature.

# -----------------------------------------------------------------------------
# Security (do not skip)
# -----------------------------------------------------------------------------
# - Never prefix secrets with NEXT_PUBLIC_ — those values are embedded in client JS.
#   Keep JWT_SECRET, MONGODB_URI, admin password, Cloudinary secret, API keys server-only.
# - Admin auth: JWT lives in an HTTP-only cookie; verify only on the server (middleware + APIs).
#   Do not put tokens in localStorage or decode JWTs in the browser.

# -----------------------------------------------------------------------------
# MongoDB — CMS + API data (hero, features, products) — server-only
# -----------------------------------------------------------------------------
MONGODB_URI=

# -----------------------------------------------------------------------------
# Cloudinary — POST /api/upload + image fields in admin — server-only secrets
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Site origin, no trailing slash — server-side fetches to this app’s /api/* (RSC).
# Prefer SITE_URL (not exposed to the browser). Vercel sets VERCEL_URL automatically.
# Optional legacy: NEXT_PUBLIC_SITE_URL if SITE_URL is unset (public URL only, not a credential).
# -----------------------------------------------------------------------------
SITE_URL=
# NEXT_PUBLIC_SITE_URL=

# -----------------------------------------------------------------------------
# Admin login — POST /api/admin/login (JWT in HTTP-only cookie) — server-only
# -----------------------------------------------------------------------------
# Required: JWT_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD. Sign in at /admin/login with these
# exact credentials. Self-registration and database-stored admin accounts are not used.
# -----------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=

# -----------------------------------------------------------------------------
# Email — SMTP (lib/mail.ts) + form inboxes
# -----------------------------------------------------------------------------
#
# Gmail SMTP setup (recommended for development / small volume):
# 1. Enable 2-Step Verification on the Google account:
#    https://myaccount.google.com/security
# 2. Create an App Password (not your normal Gmail password):
#    Google Account → Security → 2-Step Verification → App passwords
#    Choose "Mail" and your device, then paste the 16-character password below.
# 3. Use SMTP_USER = your full Gmail address; SMTP_PASS = the app password only.
# 4. Port 465 uses implicit TLS (secure: true in code). Port 587 + STARTTLS is also common.
#
# Never commit real passwords. Copy this file to `.env.local` and fill in secrets there.
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# All public forms default to info@tigerebikes.com (see constants/site-email.js).
# Optional: override where notifications are delivered (must be allowed by your SMTP provider).
CONTACT_RECEIVER_EMAIL=info@tigerebikes.com
# Optional per-endpoint overrides (otherwise CONTACT_RECEIVER_EMAIL or SITE_EMAIL is used):
# CAREERS_RECEIVER_EMAIL=info@tigerebikes.com
# TEST_RIDE_RECEIVER_EMAIL=info@tigerebikes.com

# Optional: "From" header if different from SMTP_USER (defaults to SMTP_USER if unset).
# SMTP_FROM="Tiger E-Bikes <info@tigerebikes.com>"
